{
  "name": "front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "heroku-postbuild": "npm run build",
    "start": "serve -s dist -l ${PORT:-3000}",
    "test:unit": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "knip": "knip",
    "skins:check": "node scripts/skins/check-skins.mjs",
    "wear:check": "node scripts/skins/check-wear.mjs",
    "collision:extract": "node scripts/extract-collision.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "zone:bake": "node scripts/bake-zone.mjs",
    "zone:prices": "node --experimental-strip-types scripts/zone-prices.ts",
    "topo:check": "node --experimental-strip-types --no-warnings scripts/check-topography.mjs",
    "store:apply": "node scripts/apply-store.mjs",
    "world:bounds": "node scripts/apply-world-bounds.mjs",
    "newnation:optimize": "npx --yes @gltf-transform/cli optimize ../map-src/NewNation/NewNation.glb public/assets/showroom/new_nation.glb --compress draco --texture-compress webp --texture-size 1024"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.41",
    "@dimforge/rapier3d": "0.19.3",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "globe.gl": "^2.46.2",
    "livekit-client": "2.23.0",
    "serve": "^14.2.6",
    "three": "^0.187.0",
    "tweakpane": "^4.0.5",
    "vue": "^3.5.24",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^24.10.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.20",
    "draco3dgltf": "^1.5.7",
    "knip": "^6.42.1",
    "postcss": "^8.4.49",
    "sharp": "0.34.5",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-wasm": "3.6.0",
    "vue-tsc": "^3.1.4"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}
