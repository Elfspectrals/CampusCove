{
  "name": "front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "heroku-postbuild": "npm run build",
    "start": "serve -s dist -l ${PORT:-3000}",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "skins:check": "node scripts/skins/check-skins.mjs",
    "collision:extract": "node scripts/extract-collision.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "newnation:optimize": "npx --yes @gltf-transform/cli optimize ../map-src/NewNation/NewNation.glb public/assets/showroom/new_nation.glb --compress draco --texture-compress webp --texture-size 1024"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.41",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "serve": "^14.2.6",
    "three": "^0.170.0",
    "vue": "^3.5.24",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@types/node": "^24.10.1",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.20",
    "draco3dgltf": "^1.5.7",
    "knip": "^6.42.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
