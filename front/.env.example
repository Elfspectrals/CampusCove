# Variables d'environnement du front (Vite).
# Sur Vercel : Project Settings > Environment Variables.
# En local : copier ce fichier en `.env` et adapter les valeurs.

# URL publique de ton backend Laravel sur Heroku (DOIT finir par /api)
VITE_API_URL=https://campuscove-back-xxxxx.herokuapp.com/api

# URL publique de ton serveur socket (Colyseus) sur Heroku
VITE_SOCKET_URL=https://campuscove-socket-xxxxx.herokuapp.com
