PORT=3000
CITY_MAX_PLAYERS=30
BACKEND_API_URL=http://localhost:8000/api
BACKEND_REQUEST_TIMEOUT_MS=5000

# Proximity voice is opt-in for every player. Empty ICE servers support local/LAN testing.
VOICE_ENABLED=true
VOICE_MAX_PEERS=4
VOICE_CONNECT_DISTANCE=18
VOICE_DISCONNECT_DISTANCE=22
VOICE_ICE_TRANSPORT_POLICY=all
VOICE_ICE_SERVERS_JSON=[]

# Production example (use restricted, short-lived TURN credentials):
# VOICE_ICE_TRANSPORT_POLICY=relay
# VOICE_ICE_SERVERS_JSON=[{"urls":"turns:turn.example.com:5349","username":"temporary-user","credential":"temporary-password"}]
