# Production secrets: copy to .env.prod (never committed) and fill in.
#   cp .env.prod.example .env.prod

# Public host name. campuscove.localhost works locally (Caddy's own CA, browser warning);
# a real domain with a DNS A record to the server gets a Let's Encrypt certificate.
DOMAIN=campuscove.localhost

# `make prod-key` prints one.
APP_KEY=

# Long random strings, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=
# Same value is given to the backend and the socket.
REALTIME_SHARED_SECRET=

# Without SMTP, password-reset mails are only logged and the GDPR purge refuses to run.
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Gem shop demo (docs/STRIPE.md). School project: Stripe TEST MODE ONLY, payments simulated with Stripe test cards,
# no real money. off = no new order (default), test = demo on. Production keys (sk_live_ / rk_live_) are refused.
GEMS_CHECKOUT_MODE=off
# sk_test_... (or a restricted rk_test_... key)
STRIPE_SECRET_KEY=
# Signing secret of the test-mode https://$DOMAIN/api/stripe/webhook endpoint (Dashboard in test mode > Webhooks).
STRIPE_WEBHOOK_SECRET=

ABUSEIPDB_API_KEY=
SECURITY_SCAN_TOKEN=
CLOUDFLARE_ORIGIN_SECRET=
CLOUDFLARE_ENFORCE_ORIGIN=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
